# Copy to .env and fill in only what you use. .env is git-ignored; never commit real keys.
# examples/demo.yaml and examples/quickstart.py need NO keys at all.
#
# thalamus.yaml refers to these by NAME (api_key_env / base_url_env), so you can
# rename them freely, as long as the YAML and this file agree.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local OpenAI-compatible server (no key needed). Ollama default shown;
# vLLM is usually http://localhost:8000/v1, LM Studio http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
